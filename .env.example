# Copy to .env and fill in values. Never commit .env.

# Research
TAVILY_API_KEY=tvly-...

# Script generation
ANTHROPIC_API_KEY=sk-ant-...

# TTS — ElevenLabs (primary)
ELEVENLABS_API_KEY=...

# TTS — OpenAI (fallback)
OPENAI_API_KEY=sk-...

# Clip generation — HeyGen (talking head video)
HEYGEN_API_KEY=...

# GitHub (used by Terraform to set Actions secrets)
GITHUB_TOKEN=ghp_...

# Feed delivery
AWS_S3_BUCKET=your-notecast-bucket
AWS_S3_FEED_KEY=podcast.xml
PODCAST_FEED_BASE_URL=https://your-bucket.s3.amazonaws.com
